# AstroSynth — global env template
# Copy to .env and fill in secrets. Never commit .env.

# --- App ---
APP_ENV=development
APP_NAME=AstroSynth
API_VERSION=v1
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000

# --- Database ---
POSTGRES_USER=astrosynth
POSTGRES_PASSWORD=astrosynth_dev_pw
POSTGRES_DB=astrosynth
DATABASE_URL=postgresql+psycopg://astrosynth:astrosynth_dev_pw@postgres:5432/astrosynth

# --- Auth ---
JWT_SECRET=change-me-to-a-32-char-minimum-secret!!
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# --- OAuth (optional) ---
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# --- Storage (S3-compatible) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=astrosynth
S3_REGION=us-east-1

# --- ML ---
ML_MODEL_REGISTRY_DIR=ml/artifacts
MLFLOW_TRACKING_URI=
OPTUNA_STORAGE=

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
